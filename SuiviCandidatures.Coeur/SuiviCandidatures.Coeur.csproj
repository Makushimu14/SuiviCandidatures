<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SuiviCandidatures.Coeur</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Dépendances transitives de l'outillage EF Core (Design), signalées vulnérables en 9.0.0.
    Elles sont épinglées sur la dernière version corrective 10.0.x. Elles ne sont pas embarquées dans l'application.
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    SQLitePCLRaw.lib.e_sqlite3 2.1.11 embarque SQLite 3.49.1 (GHSA-2m69-gcr7-jv3q / CVE-2025-6965).
    Aucune version corrective n'est livrée avec EF Core 10 à ce jour. L'application n'exécute que ses propres
    requêtes générées par EF Core sur une base locale : la faille nécessite du SQL malveillant, hors de notre usage.
    Avis suspendu en connaissance de cause ; à retirer dès qu'EF Core embarque une version corrigée.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

</Project>
