<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CouleurFondClair}, Dark={StaticResource CouleurFondSombre}}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource CouleurTexteClair}, Dark={StaticResource CouleurTexteSombre}}" />
    </Style>

    <Style x:Key="TitrePage" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource CouleurTexteClair}, Dark={StaticResource CouleurTexteSombre}}" />
    </Style>

    <Style x:Key="TexteSecondaire" TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource CouleurTexteSecondaireClair}, Dark={StaticResource CouleurTexteSecondaireSombre}}" />
    </Style>

    <!-- Fond explicite : sous Windows, une saisie qui prend le focus passe sinon sur un fond clair -->
    <Style TargetType="Entry">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource CouleurTexteClair}, Dark={StaticResource CouleurTexteSombre}}" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CouleurSurfaceClair}, Dark={StaticResource CouleurSurfaceSombre}}" />
        <Setter Property="PlaceholderColor"
                Value="{AppThemeBinding Light={StaticResource CouleurTexteSecondaireClair}, Dark={StaticResource CouleurTexteSecondaireSombre}}" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource CouleurTexteClair}, Dark={StaticResource CouleurTexteSombre}}" />
        <Setter Property="TitleColor"
                Value="{AppThemeBinding Light={StaticResource CouleurTexteSecondaireClair}, Dark={StaticResource CouleurTexteSecondaireSombre}}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource CouleurPrimaire}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource CouleurTexteClair}, Dark={StaticResource CouleurTexteSombre}}" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CouleurSurfaceClair}, Dark={StaticResource CouleurSurfaceSombre}}" />
        <Setter Property="PlaceholderColor"
                Value="{AppThemeBinding Light={StaticResource CouleurTexteSecondaireClair}, Dark={StaticResource CouleurTexteSecondaireSombre}}" />
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource CouleurTexteClair}, Dark={StaticResource CouleurTexteSombre}}" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource CouleurTexteClair}, Dark={StaticResource CouleurTexteSombre}}" />
    </Style>

    <Style x:Key="Carte" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource CouleurSurfaceClair}, Dark={StaticResource CouleurSurfaceSombre}}" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource CouleurContourClair}, Dark={StaticResource CouleurContourSombre}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="8" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
