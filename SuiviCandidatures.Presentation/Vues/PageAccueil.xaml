<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SuiviCandidatures.Presentation.Vues.PageAccueil"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SuiviCandidatures.Presentation.ViewModels"
             x:DataType="viewmodels:AccueilViewModel"
             Title="Accueil">
    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16">

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding Titre}" Style="{StaticResource TitrePage}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Nouvelle candidature" Command="{Binding AjouterCandidatureCommand}" />
            </Grid>

            <Label Text="{Binding MessageErreur}" TextColor="#DC2626" />

            <!-- Compteurs -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                <Border Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding NombreRelancesDues}" FontSize="32" FontAttributes="Bold" />
                        <Label Text="Relances à faire" Style="{StaticResource TexteSecondaire}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding NombreEnCours}" FontSize="32" FontAttributes="Bold" />
                        <Label Text="Candidatures en cours" Style="{StaticResource TexteSecondaire}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Carte}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding NombreEntretiensPlanifies}" FontSize="32" FontAttributes="Bold" />
                        <Label Text="Entretiens planifiés" Style="{StaticResource TexteSecondaire}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Relances à faire -->
            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Relances à faire" FontAttributes="Bold" FontSize="16" />
                    <Label Text="Aucune relance à faire pour le moment." IsVisible="{Binding AucuneRelanceDue}"
                           Style="{StaticResource TexteSecondaire}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RelancesDues}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:LigneRelance">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="QuandRelanceTapee" />
                                        </Grid.GestureRecognizers>
                                        <VerticalStackLayout>
                                            <Label Text="{Binding TitreOffre}" FontAttributes="Bold" />
                                            <Label Text="{Binding NomEntreprise}" Style="{StaticResource TexteSecondaire}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="{Binding Echeance}" HorizontalTextAlignment="End">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding EnRetard}" Value="True">
                                                        <Setter Property="TextColor" Value="#DC2626" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Text="{Binding DateAffichee}" HorizontalTextAlignment="End"
                                                   Style="{StaticResource TexteSecondaire}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <BoxView HeightRequest="1"
                                             Color="{AppThemeBinding Light={StaticResource CouleurContourClair}, Dark={StaticResource CouleurContourSombre}}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Relances à venir -->
            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding TitreRelancesAVenir}" FontAttributes="Bold" FontSize="16" />
                    <Label Text="Aucune relance prévue prochainement." IsVisible="{Binding AucuneRelanceAVenir}"
                           Style="{StaticResource TexteSecondaire}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RelancesAVenir}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:LigneRelance">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="QuandRelanceTapee" />
                                        </Grid.GestureRecognizers>
                                        <VerticalStackLayout>
                                            <Label Text="{Binding TitreOffre}" FontAttributes="Bold" />
                                            <Label Text="{Binding NomEntreprise}" Style="{StaticResource TexteSecondaire}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="{Binding Echeance}" HorizontalTextAlignment="End" />
                                            <Label Text="{Binding DateAffichee}" HorizontalTextAlignment="End"
                                                   Style="{StaticResource TexteSecondaire}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <BoxView HeightRequest="1"
                                             Color="{AppThemeBinding Light={StaticResource CouleurContourClair}, Dark={StaticResource CouleurContourSombre}}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Candidatures récentes -->
            <Border Style="{StaticResource Carte}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Candidatures récentes" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Voir toutes" Command="{Binding VoirToutesCommand}" />
                    </Grid>
                    <Label Text="Aucune candidature pour le moment. Ajoutez votre première candidature."
                           IsVisible="{Binding AucuneCandidature}" Style="{StaticResource TexteSecondaire}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CandidaturesRecentes}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:LigneCandidature">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,130,250" ColumnSpacing="16">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="QuandCandidatureTapee" />
                                        </Grid.GestureRecognizers>
                                        <VerticalStackLayout VerticalOptions="Center">
                                            <Label Text="{Binding TitreOffre}" FontAttributes="Bold" />
                                            <Label Text="{Binding NomEntreprise}" Style="{StaticResource TexteSecondaire}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding DateAffichee}" HorizontalTextAlignment="End" />
                                            <Label Text="{Binding TypeContratLibelle}" HorizontalTextAlignment="End"
                                                   Style="{StaticResource TexteSecondaire}" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2" VerticalOptions="Center"
                                                BackgroundColor="{Binding CouleurStatut}"
                                                StrokeThickness="0" Padding="12,4"
                                                StrokeShape="RoundRectangle 12">
                                            <Label Text="{Binding StatutLibelle}" TextColor="White" FontSize="12"
                                                   HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" />
                                        </Border>
                                    </Grid>
                                    <BoxView HeightRequest="1"
                                             Color="{AppThemeBinding Light={StaticResource CouleurContourClair}, Dark={StaticResource CouleurContourSombre}}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
