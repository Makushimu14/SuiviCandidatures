<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="SuiviCandidatures.Presentation.Vues.PageDetailCandidature"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SuiviCandidatures.Presentation.ViewModels"
             xmlns:transferts="clr-namespace:SuiviCandidatures.Coeur.Transferts;assembly=SuiviCandidatures.Coeur"
             xmlns:comportements="clr-namespace:SuiviCandidatures.Presentation.Comportements"
             x:DataType="viewmodels:DetailCandidatureViewModel"
             Title="Candidature">
    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16">

            <!-- En-tête -->
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding TitreOffre}" Style="{StaticResource TitrePage}" />
                    <Label Text="{Binding NomEntreprise}" FontSize="16"
                           TextColor="{StaticResource CouleurPrimaire}" TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OuvrirEntrepriseCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Border BackgroundColor="{Binding CouleurStatut}" StrokeThickness="0" Padding="12,4"
                            StrokeShape="RoundRectangle 12" HorizontalOptions="Start">
                        <Label Text="{Binding StatutLibelle}" TextColor="White" FontSize="12" />
                    </Border>
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Modifier" Command="{Binding ModifierCommand}" VerticalOptions="Start" />
                <Button Grid.Column="2" Text="Supprimer" Command="{Binding SupprimerCommand}"
                        BackgroundColor="#DC2626" VerticalOptions="Start" />
            </Grid>

            <Label Text="{Binding MessageErreur}" TextColor="#DC2626" />

            <Grid ColumnDefinitions="2*,*" ColumnSpacing="16">

                <!-- Colonne principale -->
                <VerticalStackLayout Spacing="16" VerticalOptions="Start">

                    <Border Style="{StaticResource Carte}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Informations" FontAttributes="Bold" FontSize="16" />
                            <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                <Label Text="Date de candidature" Style="{StaticResource TexteSecondaire}" />
                                <Label Grid.Column="1" Text="{Binding DateAffichee}" />
                                <Label Grid.Row="1" Text="Type de candidature" Style="{StaticResource TexteSecondaire}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding TypeCandidatureLibelle}" />
                                <Label Grid.Row="2" Text="Type de contrat" Style="{StaticResource TexteSecondaire}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding TypeContratLibelle}" />
                                <Label Grid.Row="3" Text="Adresse" Style="{StaticResource TexteSecondaire}" />
                                <Label Grid.Row="3" Grid.Column="1" Text="{Binding AdresseAffichee}" />
                                <Label Grid.Row="4" Text="Commentaires" Style="{StaticResource TexteSecondaire}" />
                                <Label Grid.Row="4" Grid.Column="1" Text="{Binding CommentairesAffiches}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Carte}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Offres" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="Ajouter une offre" Command="{Binding Offres.AjouterOffreCommand}" />
                            </Grid>

                            <Border Style="{StaticResource Carte}" IsVisible="{Binding Offres.FormulaireVisible}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding Offres.TitreFormulaire}" FontAttributes="Bold" />
                                    <Entry Text="{Binding Offres.NomSite}" Placeholder="Site (par exemple : Indeed)" />
                                    <Entry Text="{Binding Offres.Reference}" Placeholder="Référence de l'offre" />
                                    <Entry Text="{Binding Offres.Lien}" Placeholder="Lien (https://...)" Keyboard="Url" />
                                    <Label Text="{Binding Offres.MessageErreur}" TextColor="#DC2626" />
                                    <HorizontalStackLayout Spacing="12">
                                        <Button Text="Enregistrer" Command="{Binding Offres.EnregistrerOffreCommand}" />
                                        <Button Text="Annuler" Command="{Binding Offres.AnnulerOffreCommand}"
                                                BackgroundColor="Transparent" BorderWidth="1"
                                                BorderColor="{StaticResource CouleurPrimaire}"
                                                TextColor="{StaticResource CouleurPrimaire}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <Label Text="Aucune offre liée." IsVisible="{Binding Offres.AucuneOffre}"
                                   Style="{StaticResource TexteSecondaire}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Offres.Offres}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:LigneOffre">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <VerticalStackLayout>
                                                    <Label Text="{Binding TitreAffiche}" FontAttributes="Bold" />
                                                    <Label Text="{Binding ReferenceAffichee}" IsVisible="{Binding ReferenceVisible}"
                                                           Style="{StaticResource TexteSecondaire}" />
                                                    <Label Text="{Binding Lien}" IsVisible="{Binding LienVisible}"
                                                           TextColor="{StaticResource CouleurPrimaire}" TextDecorations="Underline"
                                                           LineBreakMode="TailTruncation">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="QuandLienOffreTape" />
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                </VerticalStackLayout>
                                                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Start">
                                                    <Button Text="Modifier" FontSize="12" Padding="10,4"
                                                            Clicked="QuandModifierOffreClique" />
                                                    <Button Text="Supprimer" FontSize="12" Padding="10,4"
                                                            BackgroundColor="#DC2626" Clicked="QuandSupprimerOffreClique" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                            <BoxView HeightRequest="1"
                                                     Color="{AppThemeBinding Light={StaticResource CouleurContourClair}, Dark={StaticResource CouleurContourSombre}}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Carte}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Historique" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="Ajouter une action" Command="{Binding AjouterActionCommand}" />
                            </Grid>

                            <!-- Formulaire d'ajout / modification d'une action -->
                            <Border Style="{StaticResource Carte}" IsVisible="{Binding FormulaireActionVisible}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding TitreFormulaireAction}" FontAttributes="Bold" />
                                    <Picker ItemsSource="{Binding TypesActionDisponibles}"
                                            ItemDisplayBinding="{Binding Libelle, x:DataType=viewmodels:ChoixEnumeration}"
                                            SelectedItem="{Binding TypeActionSelectionne}" />
                                    <HorizontalStackLayout Spacing="12">
                                        <DatePicker Date="{Binding DateAction}" />
                                        <TimePicker Time="{Binding HeureAction}" />
                                    </HorizontalStackLayout>
                                    <Editor Text="{Binding NoteAction}" Placeholder="Note (obligatoire pour « Autre »)"
                                            HeightRequest="80" AutoSize="Disabled" />
                                    <Label Text="{Binding MessageErreurAction}" TextColor="#DC2626" />
                                    <HorizontalStackLayout Spacing="12">
                                        <Button Text="Enregistrer" Command="{Binding EnregistrerActionCommand}" />
                                        <Button Text="Annuler" Command="{Binding AnnulerActionCommand}"
                                                BackgroundColor="Transparent" BorderWidth="1"
                                                BorderColor="{StaticResource CouleurPrimaire}"
                                                TextColor="{StaticResource CouleurPrimaire}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Actions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:LigneAction">
                                        <VerticalStackLayout Spacing="6" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="12">
                                                <Label Text="{Binding DateAffichee}" Style="{StaticResource TexteSecondaire}"
                                                       VerticalOptions="Start" />
                                                <VerticalStackLayout Grid.Column="1">
                                                    <Label Text="{Binding TypeLibelle}" FontAttributes="Bold" />
                                                    <Label Text="{Binding Detail}" IsVisible="{Binding DetailVisible}"
                                                           Style="{StaticResource TexteSecondaire}" />
                                                </VerticalStackLayout>
                                                <HorizontalStackLayout Grid.Column="2" Spacing="8" IsVisible="{Binding EstModifiable}">
                                                    <Button Text="Modifier" FontSize="12" Padding="10,4"
                                                            Clicked="QuandModifierActionClique" />
                                                    <Button Text="Supprimer" FontSize="12" Padding="10,4"
                                                            BackgroundColor="#DC2626" Clicked="QuandSupprimerActionClique" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                            <BoxView HeightRequest="1"
                                                     Color="{AppThemeBinding Light={StaticResource CouleurContourClair}, Dark={StaticResource CouleurContourSombre}}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Colonne latérale -->
                <VerticalStackLayout Grid.Column="1" Spacing="16" VerticalOptions="Start">

                    <Border Style="{StaticResource Carte}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Statut" FontAttributes="Bold" FontSize="16" />
                            <Picker ItemsSource="{Binding StatutsDisponibles}"
                                    ItemDisplayBinding="{Binding Libelle, x:DataType=viewmodels:ChoixEnumeration}"
                                    SelectedItem="{Binding StatutSelectionne}" />
                            <Button Text="Changer le statut" Command="{Binding ChangerStatutCommand}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Carte}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Relance" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding LibelleRelance}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding RelanceEnRetard}" Value="True">
                                        <Setter Property="TextColor" Value="#DC2626" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="Délai de relance propre à cette candidature (jours)" Style="{StaticResource TexteSecondaire}" />
                            <Entry Text="{Binding DelaiRelanceSaisi}" Placeholder="{Binding IndicationDelaiRelance}"
                                   MaxLength="2" Keyboard="Numeric">
                                <Entry.Behaviors>
                                    <comportements:ComportementSaisieFiltree CaracteresAutorises="0123456789" />
                                </Entry.Behaviors>
                            </Entry>
                            <HorizontalStackLayout Spacing="4">
                                <CheckBox IsChecked="{Binding RelancesDesactivees}" Color="{StaticResource CouleurPrimaire}" />
                                <Label Text="Ne plus relancer" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Button Text="Enregistrer" Command="{Binding EnregistrerRelanceCommand}" />
                            <Label Text="{Binding MessageRelance}" Style="{StaticResource TexteSecondaire}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Carte}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Contacts" FontAttributes="Bold" FontSize="16" />

                            <Label Text="Aucun contact lié." IsVisible="{Binding Contacts.AucunContact}"
                                   Style="{StaticResource TexteSecondaire}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Contacts.Contacts}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:LigneContact">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding NomComplet}" FontAttributes="Bold" />
                                            <Label Text="{Binding Details}" IsVisible="{Binding DetailsVisibles}"
                                                   Style="{StaticResource TexteSecondaire}" />
                                            <HorizontalStackLayout Spacing="8">
                                                <Button Text="Modifier" FontSize="12" Padding="10,4"
                                                        Clicked="QuandModifierContactClique" />
                                                <Button Text="Délier" FontSize="12" Padding="10,4"
                                                        BackgroundColor="#DC2626" Clicked="QuandDelierContactClique" />
                                            </HorizontalStackLayout>
                                            <BoxView HeightRequest="1"
                                                     Color="{AppThemeBinding Light={StaticResource CouleurContourClair}, Dark={StaticResource CouleurContourSombre}}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <VerticalStackLayout IsVisible="{Binding Contacts.DisponiblesVisibles}" Spacing="6">
                                <Label Text="Lier un contact de l'entreprise" Style="{StaticResource TexteSecondaire}" />
                                <Picker ItemsSource="{Binding Contacts.Disponibles}"
                                        ItemDisplayBinding="{Binding NomComplet, x:DataType=transferts:ElementContact}"
                                        SelectedItem="{Binding Contacts.ContactDisponibleSelectionne}" />
                                <Button Text="Lier" Command="{Binding Contacts.LierCommand}" />
                            </VerticalStackLayout>

                            <Button Text="Nouveau contact" Command="{Binding Contacts.AjouterContactCommand}" />

                            <Border Style="{StaticResource Carte}" IsVisible="{Binding Contacts.FormulaireVisible}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding Contacts.TitreFormulaire}" FontAttributes="Bold" />
                                    <Entry Text="{Binding Contacts.Nom}" Placeholder="Nom *" />
                                    <Entry Text="{Binding Contacts.Prenom}" Placeholder="Prénom" />
                                    <Entry Text="{Binding Contacts.Role}" Placeholder="Rôle (recruteur, manager...)" />
                                    <Entry Text="{Binding Contacts.Mail}" Placeholder="Mail" Keyboard="Email" />
                                    <Entry Text="{Binding Contacts.Telephone}" Placeholder="Téléphone" MaxLength="20" Keyboard="Telephone">
                                        <Entry.Behaviors>
                                            <comportements:ComportementSaisieFiltree CaracteresAutorises="0123456789 +-.()" />
                                        </Entry.Behaviors>
                                    </Entry>
                                    <Editor Text="{Binding Contacts.Notes}" Placeholder="Notes" HeightRequest="70" AutoSize="Disabled" />
                                    <Label Text="{Binding Contacts.MessageErreur}" TextColor="#DC2626" />
                                    <HorizontalStackLayout Spacing="12">
                                        <Button Text="Enregistrer" Command="{Binding Contacts.EnregistrerContactCommand}" />
                                        <Button Text="Annuler" Command="{Binding Contacts.AnnulerContactCommand}"
                                                BackgroundColor="Transparent" BorderWidth="1"
                                                BorderColor="{StaticResource CouleurPrimaire}"
                                                TextColor="{StaticResource CouleurPrimaire}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
